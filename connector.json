{
  "id": "jotform",
  "name": "Jotform",
  "version": "0.1.0",
  "baseUrl": "https://api.jotform.com",
  "auth": {
    "type": "header",
    "env": "JOTFORM_API_KEY",
    "header": "APIKEY"
  },
  "tools": [
    {
      "name": "jotform_list_forms",
      "description": "List account forms using the APIKEY header.",
      "method": "GET",
      "path": "/user/forms",
      "readOnly": true,
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "bindings": {
        "path": [],
        "query": {
          "limit": "limit",
          "offset": "offset"
        },
        "body": {}
      },
      "sampleArguments": {
        "limit": 10
      },
      "evidence": {
        "state": "documented",
        "providerLiveValidation": "not-run"
      },
      "provenance": [
        "https://api.jotform.com/docs/"
      ]
    },
    {
      "name": "jotform_list_submissions",
      "description": "Read one page of submissions for a chosen form; results may contain personal information.",
      "method": "GET",
      "path": "/form/{formId}/submissions",
      "readOnly": true,
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "formId": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "formId"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [
          "formId"
        ],
        "query": {
          "limit": "limit",
          "offset": "offset"
        },
        "body": {}
      },
      "sampleArguments": {
        "formId": "100000000000001",
        "limit": 10
      },
      "evidence": {
        "state": "documented",
        "providerLiveValidation": "not-run"
      },
      "provenance": [
        "https://api.jotform.com/docs/"
      ]
    }
  ],
  "workflow": {
    "name": "Jotform authorized workflow",
    "description": "Find an authorized form and read a bounded page of its submitted responses.",
    "steps": [
      "jotform_list_forms",
      "jotform_list_submissions"
    ]
